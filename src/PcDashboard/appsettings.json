{
  // Görünüm. UserName boşsa selamlamada Windows hesabındaki ad kullanılır.
  "UserName": "",
  "Accent": "#8AB4F8",
  "CardTint": "#161822",
  "CardOpacity": 0.30,
  "StartWithWindows": false,

  // Hangi monitörde açılacak. MonitorDeviceName boşsa: ikinci bir ekran varsa o (önce PreferredWidth x
  // PreferredHeight çözünürlüğünde olanı), yoksa ana ekran. Tek ekranlı bilgisayarda ilk açılış pencere modundadır.
  // Monitör adları (\\.\DISPLAY2 gibi) %LOCALAPPDATA%\WinDash\log.txt dosyasına yazılır.
  "Display": {
    "MonitorDeviceName": "",
    "PreferSecondary": true,
    "PreferredWidth": 1920,
    "PreferredHeight": 1080,
    "Topmost": false
  },

  // Masaüstü arka planı. OverridePath doluysa o görsel kullanılır.
  "Wallpaper": {
    "BlurRadius": 60,
    "DimOpacity": 0.22,
    "OverridePath": ""
  },

  // LocationLabel boşsa bulunan konumun şehri yazılır
  "Clock": {
    "LocationLabel": "",
    "Use24Hour": true,
    "ShowSeconds": true
  },

  // Open-Meteo: ücretsiz, API anahtarı gerekmez. Konum otomatik bulunur (Windows konum hizmeti, yoksa IP adresi).
  // Belirli bir yer için koordinat yaz, ör.: "Latitude": 41.0082, "Longitude": 28.9784
  "Weather": {
    "RefreshMinutes": 15
  },

  // Google Takvim > Ayarlar > Takvimi entegre et > "iCal biçimindeki gizli adres"
  "Calendar": {
    "IcsUrls": [],
    "RefreshMinutes": 15
  },

  "Media": {
    "PreferredApp": "Spotify",
    "FallbackToAnyPlayer": true
  },

  "News": {
    "RefreshMinutes": 10,
    "MaxItems": 4,
    "RotateSeconds": 0,
    "Feeds": [
      { "Name": "AA", "Url": "https://www.aa.com.tr/tr/rss/default?cat=guncel", "Category": "Gündem" },
      { "Name": "BBC Türkçe", "Url": "https://feeds.bbci.co.uk/turkce/rss.xml", "Category": "Gündem" },
      { "Name": "Webtekno", "Url": "https://www.webtekno.com/rss.xml", "Category": "Teknoloji" },
      { "Name": "Bloomberg HT", "Url": "https://www.bloomberght.com/rss", "Category": "Ekonomi" }
    ]
  },

  // Cihazlar kartı. Aygıtlar Windows'tan OTOMATİK algılanır; burada cihaz adı yazmaya gerek yok:
  //  keyboard / mouse : bağlı HID klavye ve fareler (pili okunabilen, üretici adı olan, kablosuz olan öne çıkar)
  //  headphones       : Windows'un "Kulaklık / Mikrofonlu kulaklık" dediği ses aygıtı
  //  mic / output     : Windows'ta varsayılan mikrofon ve hoparlör (kartta değiştirirsen Windows'ta da değişir)
  // Kartta satıra tıklayıp başka bir aygıt seçebilirsin; seçim state.json'a kaydedilir ("Otomatik" ile geri döner).
  // İstersen bir yuvaya kural ve ad verebilirsin, ör.:
  //   { "Slot": "keyboard", "Name": "Klavyem", "VendorId": "0x1234", "Subtitle": "2.4 GHz" }
  //   { "Slot": "headphones", "AudioNameContains": [ "Kulaklığımın adı" ] }
  "Devices": {
    "KeychronBatteryListener": true,
    "Slots": [
      { "Slot": "keyboard" },
      { "Slot": "mouse" },
      { "Slot": "headphones" },
      { "Slot": "mic" },
      { "Slot": "output" }
    ],
    // Windows'un bilemediği adlar için takma ad. Ör. optik (S/PDIF) veya 3,5 mm kabloyla bağlı bir hoparlörün
    // markası bilgisayara ulaşmaz; Windows onu yalnızca ses kartının çıkışı olarak görür:
    //   { "Contains": "Realtek Digital Output", "Name": "Masa hoparlörü", "Subtitle": "Optik (S/PDIF)" }
    "AudioAliases": []
  },

  "Controls": {
    // "all" (DDC/CI destekleyen tüm monitörler), "primary" veya log.txt'deki \\.\DISPLAY1 gibi bir ad
    "BrightnessTarget": "all",
    // "registry": Windows Gece Işığı'nı doğrudan aç/kapat; "settings": yalnızca Ayarlar sayfasını aç
    "NightLightMode": "registry"
  },

  // Sık kullanılan uygulamalar. Kartta "Ekle" ile ekleyebilir, sağ tık ile sıralayıp kaldırabilirsin;
  // kartta yapılan değişiklikler state.json'a kaydedilir ("Ekle" > "Varsayılanlara dön" bu listeye döner).
  // Varsayılan liste yaygın uygulamalardan oluşur: "Optional": true olanlar bilgisayarda kurulu değilse görünmez,
  // kurulu olanlardan ilk iki satır (Columns x 2) gösterilir.
  // Find: Başlat menüsündeki "Tüm uygulamalar" listesinde (Store uygulamaları dahil) ve masaüstünde aranan adlar.
  // Path: istersen doğrudan .exe / .lnk yolu da verebilirsin.
  "Apps": {
    "Columns": 6,
    "Defaults": [
      { "Name": "Chrome",         "Find": ["Google Chrome"], "Optional": true },
      { "Name": "Edge",           "Find": ["Microsoft Edge"], "Optional": true },
      { "Name": "Firefox",        "Find": ["Firefox", "Mozilla Firefox"], "Optional": true },
      { "Name": "Opera",          "Find": ["Opera Browser", "Opera GX Browser"], "Optional": true },
      { "Name": "Dosya Gezgini",  "Find": ["File Explorer", "Dosya Gezgini"], "Optional": true },
      { "Name": "Spotify",        "Find": ["Spotify"], "Optional": true },
      { "Name": "WhatsApp",       "Find": ["WhatsApp"], "Optional": true },
      { "Name": "Discord",        "Find": ["Discord"], "Optional": true },
      { "Name": "Telegram",       "Find": ["Telegram Desktop", "Telegram"], "Optional": true },
      { "Name": "Steam",          "Find": ["Steam"], "Optional": true },
      { "Name": "VS Code",        "Find": ["Visual Studio Code"], "Optional": true },
      { "Name": "Visual Studio",  "Find": ["Visual Studio 2026", "Visual Studio 2022", "Visual Studio 2019"], "Optional": true },
      { "Name": "Word",           "Find": ["Word"], "Optional": true },
      { "Name": "Excel",          "Find": ["Excel"], "Optional": true },
      { "Name": "Outlook",        "Find": ["Outlook (new)", "Outlook"], "Optional": true },
      { "Name": "Teams",          "Find": ["Microsoft Teams", "Teams"], "Optional": true },
      { "Name": "Hesap Makinesi", "Find": ["Calculator", "Hesap Makinesi"], "Optional": true },
      { "Name": "Not Defteri",    "Find": ["Notepad", "Not Defteri"], "Optional": true },
      { "Name": "Ayarlar",        "Find": ["Settings", "Ayarlar"], "Optional": true }
    ]
  },

  "Network": {
    "PingHost": "1.1.1.1"
  },

  // Drives boşsa Windows'un kurulu olduğu disk gösterilir. Ör.: [ "C:\\", "D:\\" ]
  "SystemMonitor": {
    "Drives": []
  }
}
