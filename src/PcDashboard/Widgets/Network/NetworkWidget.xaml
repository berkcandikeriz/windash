<UserControl x:Class="PcDashboard.Widgets.Network.NetworkWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PcDashboard.Controls">
    <!-- Tek başına Wi-Fi kartı (layout.json'da "network"). Kontrol merkezinde aynı bilgiler zaten var. -->
    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <ui:Icon Data="{Binding Icon}" Width="40" Height="40" Foreground="{DynamicResource AccentBrush}"
                 VerticalAlignment="Center"/>

        <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Details}" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Latency}" Style="{StaticResource MonoText}" FontSize="14"
                       Foreground="{StaticResource StrongBrush}" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding Throughput}" Style="{StaticResource MonoText}" FontSize="14"
                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
