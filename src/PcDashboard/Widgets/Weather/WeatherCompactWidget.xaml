<UserControl x:Class="PcDashboard.Widgets.Weather.WeatherCompactWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PcDashboard.Controls">
    <!-- Masaüstü paneli için sade hava durumu: ikon + sıcaklık · durum · en yüksek/düşük · 5 gün -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:Icon Data="{Binding Icon}" Width="48" Height="48" StrokeThickness="1.6"
                     Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Temperature}" FontSize="52" FontWeight="Light"
                           LineHeight="54" LineStackingStrategy="BlockLineHeight"/>
                <TextBlock Text="{Binding Condition}" FontSize="15" Foreground="{StaticResource StrongBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding HighLowShort}" FontSize="13" FontFamily="{StaticResource MonoFont}"
                           Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 5 günlük tahmin: kutusuz, tek satır -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}" Focusable="False" Margin="0,10,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Day}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center"/>
                        <ui:Icon Data="{Binding Icon}" Width="18" Height="18" StrokeThickness="1.8" Margin="0,5"
                                 Foreground="{StaticResource StrongBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Max}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </Grid>
</UserControl>
