<UserControl x:Class="PcDashboard.Widgets.NowPlaying.NowPlayingWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PcDashboard.Controls">
    <!-- Taslak: flex column; gap 22px -->
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,22">
            <ui:TrackedText Style="{StaticResource WidgetLabel}" Text="{Binding Header}"/>
            <TextBlock FontSize="15" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Text="{Binding Output}"/>
        </Grid>

        <!-- Kontroller: gap 28px; 52 / 60 / 80 / 60 / 52 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{StaticResource RoundButton}" Width="52" Height="52" Background="Transparent"
                    Foreground="{Binding ShuffleBrush}" Command="{Binding ShuffleCommand}" ToolTip="Karıştır">
                <ui:Icon Data="{StaticResource IconShuffle}" Width="24" Height="24"/>
            </Button>
            <Button Style="{StaticResource RoundButton}" Margin="28,0,0,0" Foreground="#E8EAED"
                    Command="{Binding PreviousCommand}" ToolTip="Önceki">
                <ui:Icon Data="{StaticResource IconPrevious}" Width="26" Height="26"/>
            </Button>
            <Button Style="{StaticResource RoundButton}" Width="80" Height="80" Margin="28,0"
                    Background="{DynamicResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}"
                    Command="{Binding PlayPauseCommand}" ToolTip="Oynat / Duraklat">
                <ui:Icon Data="{Binding PlayPauseIcon}" Width="32" Height="32" StrokeThickness="2.2"/>
            </Button>
            <Button Style="{StaticResource RoundButton}" Margin="0,0,28,0" Foreground="#E8EAED"
                    Command="{Binding NextCommand}" ToolTip="Sonraki">
                <ui:Icon Data="{StaticResource IconNext}" Width="26" Height="26"/>
            </Button>
            <Button Style="{StaticResource RoundButton}" Width="52" Height="52" Background="Transparent"
                    Foreground="{Binding RepeatBrush}" Command="{Binding RepeatCommand}" ToolTip="{Binding RepeatTooltip}">
                <ui:Icon Data="{StaticResource IconRepeat}" Width="24" Height="24"/>
            </Button>
        </StackPanel>

        <!-- İlerleme: 6px çubuk + gap 8px + süreler (mono 15px) -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,22,0,22">
            <ProgressBar Style="{StaticResource GlassBar}" Value="{Binding Progress, Mode=OneWay}"/>
            <Grid Margin="0,8,0,0">
                <TextBlock Style="{StaticResource MonoText}" Foreground="{StaticResource MutedBrush}" Text="{Binding PositionText}"/>
                <TextBlock Style="{StaticResource MonoText}" Foreground="{StaticResource MutedBrush}" Text="{Binding DurationText}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>

        <!-- Kapak 260px (radius 16px) + gap 32px + bilgiler (gap 10px) -->
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Width="260" Height="260">
                <Border CornerRadius="16" Background="{StaticResource ButtonBrush}">
                    <ui:Icon Data="{StaticResource IconMusic}" Width="72" Height="72" StrokeThickness="1.5"
                             Foreground="#8CFFFFFF"/>
                </Border>
                <Border CornerRadius="16">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" Margin="32,0,0,0" VerticalAlignment="Center">
                <!-- font-size 38px; weight 700; line-height 1.15 -->
                <TextBlock Text="{Binding Title}" FontSize="38" FontWeight="Bold" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" LineHeight="44" LineStackingStrategy="BlockLineHeight"
                           MaxHeight="88"/>
                <TextBlock Text="{Binding Artist}" FontSize="22" Foreground="{StaticResource StrongBrush}"
                           Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Album}" FontSize="17" Foreground="{StaticResource MutedBrush}"
                           Margin="0,10,0,0" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Album, Converter={StaticResource TextToVis}}"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
