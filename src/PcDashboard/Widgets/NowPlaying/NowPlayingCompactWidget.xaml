<UserControl x:Class="PcDashboard.Widgets.NowPlaying.NowPlayingCompactWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PcDashboard.Controls">
    <!--
        Masaüstü paneli için tek parça "Şu an çalıyor" (dar panele uygun):
        kapak + başlık / sanatçı · ilerleme · kontroller
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Width="72" Height="72" VerticalAlignment="Center">
                <Border CornerRadius="12" Background="{StaticResource ButtonBrush}">
                    <ui:Icon Data="{StaticResource IconMusic}" Width="30" Height="30" StrokeThickness="1.5"
                             Foreground="#8CFFFFFF"/>
                </Border>
                <Border CornerRadius="12">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Header}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Artist}" FontSize="14" Foreground="{StaticResource StrongBrush}"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <!-- 1:24 ━━━━━━━━━ 3:41 -->
        <Grid Grid.Row="2" Margin="0,12,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource MonoText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                       Text="{Binding PositionText}" VerticalAlignment="Center"/>
            <ProgressBar Grid.Column="1" Style="{StaticResource GlassBar}" Height="4" Margin="10,0"
                         VerticalAlignment="Center" Value="{Binding Progress, Mode=OneWay}"/>
            <TextBlock Grid.Column="2" Style="{StaticResource MonoText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                       Text="{Binding DurationText}" VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{StaticResource RoundButton}" Width="34" Height="34" Background="Transparent"
                    Foreground="{Binding ShuffleBrush}" Command="{Binding ShuffleCommand}" ToolTip="Karıştır">
                <ui:Icon Data="{StaticResource IconShuffle}" Width="17" Height="17"/>
            </Button>
            <Button Style="{StaticResource RoundButton}" Width="38" Height="38" Margin="10,0,0,0" Foreground="#E8EAED"
                    Background="Transparent" Command="{Binding PreviousCommand}" ToolTip="Önceki">
                <ui:Icon Data="{StaticResource IconPrevious}" Width="19" Height="19"/>
            </Button>
            <Button Style="{StaticResource RoundButton}" Width="46" Height="46" Margin="10,0"
                    Background="{DynamicResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}"
                    Command="{Binding PlayPauseCommand}" ToolTip="Oynat / Duraklat">
                <ui:Icon Data="{Binding PlayPauseIcon}" Width="21" Height="21" StrokeThickness="2.2"/>
            </Button>
            <Button Style="{StaticResource RoundButton}" Width="38" Height="38" Margin="0,0,10,0" Foreground="#E8EAED"
                    Background="Transparent" Command="{Binding NextCommand}" ToolTip="Sonraki">
                <ui:Icon Data="{StaticResource IconNext}" Width="19" Height="19"/>
            </Button>
            <Button Style="{StaticResource RoundButton}" Width="34" Height="34" Background="Transparent"
                    Foreground="{Binding RepeatBrush}" Command="{Binding RepeatCommand}" ToolTip="{Binding RepeatTooltip}">
                <ui:Icon Data="{StaticResource IconRepeat}" Width="17" Height="17"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
