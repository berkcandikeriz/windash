<UserControl x:Class="PcDashboard.Widgets.Clock.ClockWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PcDashboard.Controls">
    <!-- Taslak: flex column; justify-content: space-between -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <ui:TrackedText Style="{StaticResource WidgetLabel}" Text="{Binding Greeting}"/>
            <TextBlock FontSize="15" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Text="{Binding Zone}"/>
        </Grid>

        <!-- font-size 132px; weight 300; letter-spacing -0.04em; saniye 36px mono, taban çizgisi hizalı, gap 12px -->
        <ui:BaselinePanel Grid.Row="1" Spacing="12" VerticalAlignment="Center">
            <ui:TrackedText Text="{Binding Time}" FontSize="132" FontWeight="Light" Tracking="-0.04"/>
            <ui:TrackedText Text="{Binding Seconds}" FontSize="36" FontFamily="{StaticResource MonoFont}"
                            Foreground="{StaticResource MutedBrush}"
                            Visibility="{Binding ShowSeconds, Converter={StaticResource BoolToVis}}"/>
        </ui:BaselinePanel>

        <Grid Grid.Row="2">
            <TextBlock Text="{Binding Date}" FontSize="26" FontWeight="Medium" VerticalAlignment="Bottom"/>
            <TextBlock FontSize="16" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"
                       VerticalAlignment="Bottom" Text="{Binding Week}"/>
        </Grid>
    </Grid>
</UserControl>
