<UserControl x:Class="PcDashboard.Widgets.Clock.ClockCompactWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PcDashboard.Controls">
    <!-- Masaüstü paneli için sade saat: selamlama · büyük saat · tarih ve konum -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Greeting}" FontSize="14" Foreground="{StaticResource MutedBrush}"
                   TextTrimming="CharacterEllipsis"/>

        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"
                 VerticalAlignment="Center">
            <ui:BaselinePanel Spacing="8">
                <ui:TrackedText Text="{Binding Time}" FontSize="84" FontWeight="Light" Tracking="-0.04"/>
                <ui:TrackedText Text="{Binding Seconds}" FontSize="22" FontFamily="{StaticResource MonoFont}"
                                Foreground="{StaticResource MutedBrush}"
                                Visibility="{Binding ShowSeconds, Converter={StaticResource BoolToVis}}"/>
            </ui:BaselinePanel>
        </Viewbox>

        <StackPanel Grid.Row="2">
            <TextBlock Text="{Binding Date}" FontSize="16" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Zone}" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Grid>
</UserControl>
