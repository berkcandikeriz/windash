<UserControl x:Class="PcDashboard.Widgets.Agenda.AgendaWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PcDashboard.Controls">
    <!-- Taslak: iki eşit sütun, gap 28px -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Ay görünümü: başlık + gap 10px + 7 sütunluk ızgara (gap 2px, font 14px, hücre padding 3px 0) -->
        <StackPanel>
            <ui:TrackedText Style="{StaticResource WidgetLabel}" Text="{Binding MonthTitle}" HorizontalAlignment="Left"/>

            <ItemsControl ItemsSource="{Binding Cells}" Focusable="False" Margin="-1,10,-1,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Bd" CornerRadius="8" Margin="1" Padding="0,3">
                            <TextBlock x:Name="Tx" Text="{Binding Text}" FontSize="14"
                                       Foreground="{StaticResource StrongBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasEvent}" Value="True">
                                <Setter TargetName="Tx" Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                                <Setter TargetName="Tx" Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Bugün: gap 12px; etkinlik = 4px renk çubuğu + başlık 17px/600 + saat 14px -->
        <DockPanel Grid.Column="2">
            <ui:TrackedText DockPanel.Dock="Top" Style="{StaticResource WidgetLabel}" Text="Bugün"
                            HorizontalAlignment="Left" Margin="0,0,0,12"/>
            <TextBlock DockPanel.Dock="Bottom" FontSize="14" Foreground="{StaticResource MutedBrush}" Text="{Binding Footer}"/>

            <Grid>
                <ItemsControl ItemsSource="{Binding Today}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{Binding Color}" CornerRadius="2"/>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding TimeText}" FontSize="14" Margin="0,2,0,0"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding EmptyText}" FontSize="14" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Top"
                           Visibility="{Binding HasNoEvents, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
