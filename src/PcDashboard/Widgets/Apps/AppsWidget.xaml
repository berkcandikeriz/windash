<UserControl x:Class="PcDashboard.Widgets.Apps.AppsWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PcDashboard.Controls">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <ui:TrackedText Style="{StaticResource WidgetLabel}" Text="Uygulamalar"/>
            <Button Style="{StaticResource ChipButton}" HorizontalAlignment="Right" Click="Add_Click"
                    ToolTip="Uygulama ekle">
                <StackPanel Orientation="Horizontal">
                    <ui:Icon Data="{StaticResource IconPlus}" Width="14" Height="14" StrokeThickness="2.2"
                             Foreground="{StaticResource StrongBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Ekle" Margin="6,0,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl x:Name="TileList" ItemsSource="{Binding Tiles}" Focusable="False" Margin="-6,-4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Kutucuk: 64px cam kare (radius 18) içinde 40px ikon + 13px ad -->
                        <Button Style="{StaticResource PlainButton}" Margin="6,4" ToolTip="{Binding Tooltip}"
                                Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" MouseRightButtonUp="Tile_RightClick">
                            <StackPanel x:Name="Root" HorizontalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource ButtonBrush}"
                                        HorizontalAlignment="Center">
                                    <Grid>
                                        <Image Source="{Binding Icon}" Width="40" Height="40"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="?" FontSize="24" FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource StrongBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           MaxWidth="86" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
