<UserControl x:Class="PcDashboard.Widgets.Devices.DevicesCompactWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PcDashboard.Controls">
    <!-- Masaüstü paneli için sade cihaz listesi: satırlar kartın yüksekliğine eşit dağılır -->
    <ItemsControl ItemsSource="{Binding Slots}" Focusable="False">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Columns="1"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- İkon: hızlı işlem (mikrofon/hoparlör: sessize al, kulaklık: varsayılan yap) -->
                    <Button Style="{StaticResource PlainButton}" VerticalAlignment="Center"
                            ToolTip="{Binding QuickActionTooltip}"
                            Command="{Binding DataContext.QuickActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource ButtonBrush}">
                            <ui:Icon Data="{Binding Icon}" Width="18" Height="18" StrokeThickness="1.8"
                                     Foreground="{StaticResource StrongBrush}"/>
                        </Border>
                    </Button>

                    <!-- Ad + durum; tıklayınca aygıt seçimi -->
                    <Button Grid.Column="1" Style="{StaticResource PlainButton}" Margin="12,0,0,0"
                            VerticalAlignment="Center" ToolTip="{Binding Tooltip}" Click="Row_Click"
                            MouseRightButtonUp="Row_RightClick">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12" Margin="8,0,0,0"
                                           Foreground="{Binding StatusBrush}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusMono}" Value="True">
                                                    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- İkinci satır: ince pil çubuğu / mikrofon seviyesi / alt yazı -->
                            <Grid Margin="0,5,0,0">
                                <ProgressBar Style="{StaticResource GlassBar}" Height="4" VerticalAlignment="Center"
                                             Value="{Binding Battery, Mode=OneWay}" Foreground="{Binding BatteryBrush}"
                                             Visibility="{Binding ShowBattery, Converter={StaticResource BoolToVis}}"/>

                                <ItemsControl ItemsSource="{Binding Meter}" Height="6" Margin="-1,0" Focusable="False"
                                              Visibility="{Binding ShowMeter, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Seg" Margin="1,0" CornerRadius="1.5" Background="{StaticResource TrackBrush}"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                    <Setter TargetName="Seg" Property="Background" Value="{StaticResource OkBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding ShowSubtitle, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </StackPanel>
                    </Button>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
