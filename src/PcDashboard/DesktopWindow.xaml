<Window x:Class="PcDashboard.DesktopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PcDashboard.Controls"
        Title="WinDash masaüstü"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        WindowStartupLocation="Manual"
        Left="0" Top="0" Width="384" Height="1036"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale">

    <!--
        Masaüstüne gömülü panel: pencerelerin arkasında, duvar kâğıdının üzerinde duran cam kartlar.
        Kartların arası tamamen saydamdır (tıklama masaüstüne geçer). Kartların altındaki bulanık cam,
        duvar kâğıdının o bölgesinden üretilir (bkz. DesktopWindow.ComposeBackdrop).
    -->
    <Viewbox Stretch="Uniform">
        <Grid x:Name="DesignRoot" Width="400" Height="1080">
            <Canvas ClipToBounds="True" IsHitTestVisible="False">
                <Image x:Name="BackdropImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Canvas>
            <Grid x:Name="WidgetGrid" Margin="12"/>

            <!-- Düzenle: fare kartların üstündeyken sağ üst köşede belirir -->
            <Button x:Name="EditButton" Style="{StaticResource RoundButton}" Width="34" Height="34"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,28,28,0"
                    Background="{StaticResource PopupBrush}" Foreground="{StaticResource StrongBrush}"
                    Visibility="Collapsed" Click="EditButton_Click"
                    ToolTip="Düzenle · kartları taşı ve boyutlandır">
                <ui:Icon Data="{StaticResource IconEdit}" Width="16" Height="16" StrokeThickness="2"/>
            </Button>
        </Grid>
    </Viewbox>
</Window>
