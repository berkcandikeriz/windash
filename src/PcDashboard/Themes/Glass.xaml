<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:PcDashboard.Controls">
    <!--
        Tüm değerler tasarım taslağından (1920x1080) birebir alınmıştır.
        CSS rgba(255,255,255,a) karşılıkları: 0.72 → #B8, 0.88 → #E0, 0.09 → #17, 0.12 → #1F, 0.14 → #24, 0.18 → #2E
    -->

    <!-- ========== Renkler ========== -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="StrongBrush" Color="#E0FFFFFF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#B8FFFFFF"/>
    <SolidColorBrush x:Key="InnerBrush" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="IconOffBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="OkBrush" Color="#6FCF97"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#F5A524"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0E1013"/>
    <SolidColorBrush x:Key="PopupBrush" Color="#F21A1D28"/>
    <!-- Aşağıdaki iki fırça appsettings.json'a göre çalışma anında değiştirilir (DynamicResource ile kullan) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#8AB4F8"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#4D161822"/>

    <!-- ========== Yazı tipleri (Fonts klasöründen gömülü) ========== -->
    <FontFamily x:Key="UiFont">pack://application:,,,/Fonts/#Manrope</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/Fonts/#JetBrains Mono</FontFamily>

    <!-- ========== Dönüştürücüler ========== -->
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <ui:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    <ui:TextToVisibilityConverter x:Key="TextToVis"/>
    <ui:UpperTrConverter x:Key="Upper"/>

    <!--
        ========== Cam kart ==========
        background: rgba(22,24,34,0.30)            → CardBackgroundBrush
        border: 1px solid rgba(255,255,255,0.18)   → #2EFFFFFF
        inset 0 1px 0 rgba(255,255,255,0.28)       → üst iç çizgi #47FFFFFF
        inset 0 -1px 0 rgba(255,255,255,0.06)      → alt iç çizgi #0FFFFFFF
        backdrop-filter + box-shadow               → MainWindow'da arka plan bitmap'ine işlenir
    -->
    <Style x:Key="GlassCard" TargetType="ContentControl">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border CornerRadius="28" Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="#2EFFFFFF" BorderThickness="1"/>
                        <Border CornerRadius="27" Margin="1" BorderThickness="0,1,0,0" BorderBrush="#47FFFFFF"/>
                        <Border CornerRadius="27" Margin="1" BorderThickness="0,0,0,1" BorderBrush="#0FFFFFFF"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Metin stilleri ========== -->
    <!-- font-size:15px; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; color:.72 -->
    <Style x:Key="WidgetLabel" TargetType="ui:TrackedText">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Tracking" Value="0.08"/>
        <Setter Property="Uppercase" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <!-- ========== İkon ========== -->
    <Style TargetType="ui:Icon">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:Icon">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Data="{TemplateBinding Data}"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="{TemplateBinding StrokeThickness}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== İlerleme çubuğu: height 6px; radius 3px; track .18 ========== -->
    <Style x:Key="GlassBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="3" Background="{StaticResource TrackBrush}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Hap kaydırıcı (parlaklık / ses): height 44px; radius 22px ========== -->
    <Style TargetType="ui:PillSlider">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:PillSlider">
                    <Grid x:Name="PART_Root" Background="{StaticResource ButtonBrush}">
                        <Border x:Name="PART_Fill" HorizontalAlignment="Left" Width="0" Background="{TemplateBinding Fill}"/>
                        <ui:Icon Data="{TemplateBinding Icon}" Width="22" Height="22" StrokeThickness="2"
                                 HorizontalAlignment="Left" Margin="14,0,0,0"
                                 Foreground="{StaticResource OnAccentBrush}"/>
                        <TextBlock Text="{TemplateBinding Text}" FontFamily="{StaticResource MonoFont}" FontSize="14"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Butonlar ========== -->
    <Style x:Key="RoundButton" TargetType="Button">
        <Setter Property="Width" Value="60"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="Background" Value="{StaticResource ButtonBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Bg" Fill="{TemplateBinding Background}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.65"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pencere kontrol çubuğu düğmesi: 38x32, radius 10, ikon 16px -->
    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="{StaticResource StrongBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Kapat: üzerine gelince kırmızı -->
    <Style x:Key="ChromeCloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E5484D"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C93A3F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Görünmez, tıklanabilir alan (haber satırı, cihaz satırı) -->
    <Style x:Key="PlainButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter x:Name="Cp" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Cp" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Kontrol merkezi kutucuğu: padding 12px 14px; radius 20px; bg .12 -->
    <Style x:Key="TileButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource ButtonBrush}" CornerRadius="20" Padding="14,12">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#29FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Haber kategori sekmesi: font 14; padding 6px 12px; radius 999px -->
    <Style x:Key="ChipButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource StrongBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Açılır seçim listesindeki satır -->
    <Style x:Key="MenuRowButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="12,9">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bağlam menüsü (sağ tık) -->
    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!--
        Cam ipucu (tüm uygulamada): koyu cam zemin, ince açık kenar, 12px köşe.
        Açılır pencereler arkasındaki bulanık zemini göremediği için zemin kartlardan daha opaktır.
    -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Placement" Value="Bottom"/>
        <Setter Property="VerticalOffset" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource PopupBrush}" BorderBrush="#2EFFFFFF" BorderThickness="1"
                            CornerRadius="12" Padding="12,7" Margin="0,0,0,8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.35" Color="Black"/>
                        </Border.Effect>
                        <ContentPresenter TextElement.Foreground="{StaticResource TextBrush}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="MaxWidth" Value="320"/>
                                    <Setter Property="LineHeight" Value="19"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
